#: ../../source/development/release.rst:2
msgid "Release"
msgstr "Release"

#: ../../source/development/release.rst:4
msgid "To release a new version:"
msgstr "Para publicar uma nova versão:"

#: ../../source/development/release.rst:6
msgid "Update ``CHANGES.rst``."
msgstr "Atualize ``CHANGES.rst``."

#: ../../source/development/release.rst:7
msgid "Review ``setup.py`` metadata and dependencies."
msgstr "Revise os metadados e dependências em ``setup.py``."

#: ../../source/development/release.rst:8
msgid "Review documentation."
msgstr "Revise a documentação."

#: ../../source/development/release.rst:9
msgid "Run tests with ``make test``."
msgstr "Execute os testes com ``make test``."

#: ../../source/development/release.rst:10
msgid "Run Django checks with ``make check``."
msgstr "Execute os checks do Django com ``make check``."

#: ../../source/development/release.rst:11
msgid "Build with ``make build``."
msgstr "Gere o build com ``make build``."

#: ../../source/development/release.rst:12
msgid "Check distribution metadata with ``uv run --extra dev twine check dist/*``."
msgstr ""
"Verifique os metadados da distribuição com ``uv run --extra dev twine check "
"dist/*``."

#: ../../source/development/release.rst:13
msgid "Commit and push changes."
msgstr "Faça commit e push das mudanças."

#: ../../source/development/release.rst:14
msgid "Release with ``make release``."
msgstr "Publique com ``make release``."

